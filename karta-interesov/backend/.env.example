# Скопируйте в .env (файл .env в Git не попадает) и заполните СВОИМИ значениями.
# Реальные пароли и секреты сюда не записывайте.

APP_ENV=local            # local | production
APP_DEBUG=false          # true только локально: добавляет в ответ 500 текст исключения

# Путь, по которому доступен API (с него начинается URL запроса)
API_BASE_PATH=/api/v1

# Разрешённые origin frontend через запятую. "*" не поддерживается намеренно.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=karta_interesov
DB_USER=karta_app
DB_PASSWORD=

# Версия теста (должна совпадать с TEST_VERSION в src/types/index.ts)
TEST_VERSION=golomshtok-174-v1

# Таймер (мс). QUESTION_TIME_MS должен совпадать с QUESTION_TIME_MS во frontend (15000).
QUESTION_TIME_MS=15000
# Запас на задержку сети: ответ принимается, если пришёл не позже QUESTION_TIME_MS + ANSWER_GRACE_MS
ANSWER_GRACE_MS=1000
# Пропуск принимается не раньше, чем QUESTION_TIME_MS - SKIP_TOLERANCE_MS после открытия вопроса
SKIP_TOLERANCE_MS=1000

# Администраторы
ADMIN_TOKEN_TTL_MINUTES=480
ADMIN_MAX_FAILED_LOGINS=5
ADMIN_LOCK_MINUTES=15

# Необязательно: каталог с categories.json / questions.json / regions.json (по умолчанию ../docs/data)
# CATALOG_DIR=
# Необязательно: файл журнала ошибок (по умолчанию storage/logs/app.log)
# LOG_FILE=
