# Скопируйте этот файл в .env.local и при необходимости измените значения.
# ВАЖНО: всё, что начинается с VITE_, попадает в публичный JS-код сайта.
# Никогда не записывайте сюда пароли, токены и ключи доступа.

# api  — запросы идут на PHP API и сохраняются в MySQL
# demo — только просмотр прототипа; регистрация, БД и админ-аналитика недоступны
VITE_API_MODE=api

# Базовый адрес API без завершающего слэша
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Таймаут запроса в миллисекундах (1000–120000, по умолчанию 15000)
VITE_API_TIMEOUT_MS=15000
