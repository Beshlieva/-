# Скопируйте этот файл в .env.local и подставьте значения своего проекта.
# ВАЖНО: всё, что начинается с VITE_, попадает в публичный JS-код сайта.
# Никогда не записывайте сюда секретный ключ Supabase (sb_secret_…), пароли и токены.

# ── Основной режим: облачная база Supabase ──
# Supabase → Project Settings → API (или Connect): Project URL и publishable/anon key
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Режим работы: supabase | php | demo.
# Если не задан: есть VITE_SUPABASE_URL и VITE_SUPABASE_ANON_KEY → supabase,
# VITE_API_MODE=api → php, иначе → demo (без сервера, тест считается в браузере).
VITE_APP_MODE=supabase

# ── Прежний режим: PHP API + MySQL (нужен только при VITE_APP_MODE=php) ──
# VITE_API_MODE=api
# VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
# VITE_API_TIMEOUT_MS=15000
